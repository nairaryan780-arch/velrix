# Database
DATABASE_URL="postgresql://velrix:velrix@localhost:5432/velrix"

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Auth (generate with: openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-secret"

# Encrypts WhatsApp/Instagram/Razorpay secrets at rest (32+ chars)
ENCRYPTION_KEY="replace-with-32-plus-character-key"

# Cron/worker shared secret for /api/cron/*
CRON_SECRET="replace-with-cron-secret"

# AI — optional. Without a key, Velrix uses the local retrieval salesperson engine.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
AI_TIMEOUT_MS="30000"

# Email — optional. Without SMTP, verification/reset links are logged (dev only).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Velrix <noreply@localhost>"

# Billing — Razorpay (INR). Leave empty to use test checkout without charging.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN="velrix-whatsapp-verify"

# Instagram Messaging (Meta)
INSTAGRAM_VERIFY_TOKEN="velrix-instagram-verify"

# Demo workspace (seed)
SEED_DEMO="true"
